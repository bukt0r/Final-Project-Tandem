generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Question {
  id         String     @id @default(cuid())
  title      String
  difficulty Difficulty
  content    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  
  // Many-to-many relationship with topics
  topics     Topic[]    @relation("QuestionTopics")
  
  @@map("questions")
}

model Topic {
  id          String     @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // Many-to-many relationship with questions
  questions   Question[] @relation("QuestionTopics")
  
  @@map("topics")
}

enum Difficulty {
  easy
  medium
  hard
}